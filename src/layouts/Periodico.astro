---
import '../styles/global.css';
import RolloPelicula from '../components/RolloPelicula.astro';
import NavMovil from '../components/NavMovil.astro';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Segunda Vida Digital',
  description = 'Periódico ecológico de Ingeniería de Software · Universidad Surcolombiana. El hardware no muere, lo jubila el código.',
} = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#234D38" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base.replace(/\/?$/, '/')}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@700;800;900&family=Poppins:wght@400&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,700;1,8..60,400;1,8..60,700&display=swap"
    />
  </head>
  <body>
    <RolloPelicula />
    <NavMovil />
    <main class="pagina">
      <slot />
    </main>
  </body>
</html>
