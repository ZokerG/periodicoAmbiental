---
interface Props {
  tamano?: number;
}
const { tamano = 120 } = Astro.props;
---
<figure class="qr" style={`--t:${tamano}px`}>
  <img data-qr alt="Código QR con la dirección de esta web" width={tamano} height={tamano} />
  <figcaption>Escanee para abrir la web</figcaption>
</figure>

<script>
  import QRCode from 'qrcode';
  import { urlPublica } from '../lib/diagnostico';

  const url = urlPublica(location.origin, import.meta.env.BASE_URL);
  document.querySelectorAll<HTMLImageElement>('img[data-qr]').forEach(async img => {
    try {
      img.src = await QRCode.toDataURL(url, {
        margin: 1,
        width: 360,
        color: { dark: '#234D38', light: '#FFFFFF' },
      });
      img.title = url;
    } catch {
      img.closest('figure')?.setAttribute('hidden', '');
    }
  });
</script>

<style>
  .qr {
    margin: 0;
    padding: 8px;
    border: 2px dashed var(--cobre);
    background: #fff;
    width: calc(var(--t) + 20px);
    flex: none;
    text-align: center;
  }
  img {
    width: var(--t);
    height: var(--t);
    background: var(--verde-palido);
  }
  figcaption {
    font-family: var(--f-detalle);
    font-size: 0.62rem;
    line-height: 1.3;
    color: var(--gris);
    margin-top: 6px;
  }
</style>
